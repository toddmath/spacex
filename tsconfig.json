{
  "compilerOptions": {
    // "target": "es5",
    "target": "es2025",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "noPropertyAccessFromIndexSignature": false,
    "paths": {
      "types/*": ["./types/*"],
      "utils/*": ["./utils/*"],
      "components/*": ["./components/*"],
      "lib/*": ["./lib/*"],
      "styles/*": ["./styles/*"],
      "pages/*": ["./pages/*"],
      "@/*": ["./*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".agents/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
